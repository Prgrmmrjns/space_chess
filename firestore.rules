rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function matchDoc(id) {
      return get(/databases/$(database)/documents/matches/$(id)).data;
    }

    function profileElo(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data.elo;
    }

    function awardNear(uid, award) {
      return award is number
        && award == math.round(award)
        && exists(/databases/$(database)/documents/profiles/$(uid))
        && award >= profileElo(uid) - 32
        && award <= profileElo(uid) + 32;
    }

    function ownFinishedAward(uid) {
      let row = matchDoc(request.resource.data.lastMatch);
      return request.resource.data.lastMatch is string
        && exists(/databases/$(database)/documents/matches/$(request.resource.data.lastMatch))
        && row.status == 'done'
        && row.white_id is string
        && row.black_id is string
        && row.white_id != row.black_id
        && (
          (row.white_id == uid && request.resource.data.elo == row.white_elo)
          || (row.black_id == uid && request.resource.data.elo == row.black_elo)
        );
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.elo == 1200
        && request.resource.data.games == 0
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,16}$');
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.games == resource.data.games + 1
        && request.resource.data.elo >= resource.data.elo - 32
        && request.resource.data.elo <= resource.data.elo + 32
        && ownFinishedAward(uid)
        && resource.data.get('lastMatch', '') != request.resource.data.lastMatch;
      allow delete: if false;
    }

    match /matches/{id} {
      allow read: if resource.data.status == 'open'
        || (request.auth != null && (
          request.auth.uid == resource.data.white_id
          || request.auth.uid == resource.data.black_id
        ));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.white_id
        && request.resource.data.status == 'open'
        && request.resource.data.black_id == null
        && request.resource.data.winner == null
        && request.resource.data.white_elo == null
        && request.resource.data.black_elo == null
        && request.resource.data.rated == true;
      allow update: if request.auth != null
        && resource.data.status != 'done'
        && request.resource.data.white_id == resource.data.white_id
        && request.resource.data.white_civ == resource.data.white_civ
        && request.resource.data.rated == resource.data.rated
        && request.resource.data.code == resource.data.code
        && (
          (
            resource.data.status == 'open'
            && resource.data.black_id == null
            && request.auth.uid == request.resource.data.black_id
            && request.auth.uid != resource.data.white_id
            && request.resource.data.status == 'playing'
            && request.resource.data.white_elo == null
            && request.resource.data.black_elo == null
          )
          || (
            resource.data.status == 'playing'
            && resource.data.black_id is string
            && resource.data.black_id != resource.data.white_id
            && request.resource.data.black_id == resource.data.black_id
            && request.resource.data.black_civ == resource.data.black_civ
            && (
              request.auth.uid == resource.data.white_id
              || request.auth.uid == resource.data.black_id
            )
            && (
              (
                request.resource.data.status == 'playing'
                && request.resource.data.white_elo == null
                && request.resource.data.black_elo == null
              )
              || (
                request.resource.data.status == 'done'
                && (
                  request.resource.data.winner == 'white'
                  || request.resource.data.winner == 'black'
                  || request.resource.data.winner == null
                )
                && awardNear(resource.data.white_id, request.resource.data.white_elo)
                && awardNear(resource.data.black_id, request.resource.data.black_elo)
              )
            )
          )
        );
      allow delete: if false;
    }
  }
}
